# Copy to .env on the server (chmod 600). Never commit .env.

# Public address of this instance
BASE_URL=https://practice.betteryouhypnotherapy.co.uk
APP_HOST_PORT=8100
NOINDEX=true            # keep true until cutover is agreed

# Database (private; compose network only). Generate: openssl rand -hex 24  (hex only: it is embedded in a URL, so / + = characters would break it)
POSTGRES_USER=byhflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=byhflow

# Session/cookie signing secret, 32+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=

# Sign-in emails. graph = send through Microsoft Graph (default).
MAIL_TRANSPORT=graph

# Document encryption key, 32 bytes base64. Generate: openssl rand -base64 32
# Keep a copy somewhere SEPARATE from the server and its backups: without it, stored
# documents cannot be read; with it next to the backups, encryption protects nothing.
FILE_ENCRYPTION_KEY=

# Practice identity / branding (phase 2 onward)
PRACTICE_NAME=Your Practice
PRACTICE_SHORT=Your Practice
BRAND_PRIMARY=#01a6a8

# Microsoft Graph (mail now, calendar later). Same app registration the ITC app uses.
# GRAPH_SENDER is the mailbox sign-in emails come from.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
